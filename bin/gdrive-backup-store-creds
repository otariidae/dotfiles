#!/usr/bin/env bash
# Store secrets for gdrive-backup.service (systemd LoadCredentialEncrypted=).
# Encrypts with systemd-creds --user into ~/.config/credstore.encrypted/.
set -euo pipefail

readonly CREDSTORE_ENC="${XDG_CONFIG_HOME:-$HOME/.config}/credstore.encrypted"

do_gdrive=0
do_nas=0
do_crypt=0

usage() {
  cat <<'EOF'
Usage: bin/gdrive-backup-store-creds [--gdrive] [--nas] [--crypt]

With no flags, prompts for all credential groups.

Writes user-encrypted credential files under ~/.config/credstore.encrypted/
for LoadCredentialEncrypted= in gdrive-backup.service.
EOF
}

if [[ $# -eq 0 ]]; then
  do_gdrive=1
  do_nas=1
  do_crypt=1
else
  for arg in "$@"; do
    case "$arg" in
      --gdrive) do_gdrive=1 ;;
      --nas) do_nas=1 ;;
      --crypt) do_crypt=1 ;;
      -h | --help)
        usage
        exit 0
        ;;
      *)
        printf 'Unknown argument: %s\n' "$arg" >&2
        usage >&2
        exit 2
        ;;
    esac
  done
fi

if ! command -v systemd-creds >/dev/null; then
  printf 'Missing required command: systemd-creds\n' >&2
  exit 1
fi

mkdir -p "$CREDSTORE_ENC"
chmod 700 "$CREDSTORE_ENC"

prompt() {
  local var_name="$1"
  local label="$2"
  local value=""
  if [[ -t 0 ]]; then
    read -r -s -p "$label" value
    printf '\n'
  else
    printf 'Need a TTY to read %s securely.\n' "$var_name" >&2
    exit 1
  fi
  if [[ -z "$value" ]]; then
    printf 'Empty %s; aborting.\n' "$var_name" >&2
    exit 1
  fi
  printf -v "$var_name" '%s' "$value"
}

write_cred() {
  local name="$1"
  local value="$2"
  local path="${CREDSTORE_ENC}/${name}"
  local tmp
  tmp="$(mktemp)"
  printf '%s' "$value" >"$tmp"
  chmod 600 "$tmp"
  if ! systemd-creds encrypt --user --name="$name" "$tmp" "$path"; then
    rm -f "$tmp"
    return 1
  fi
  rm -f "$tmp"
  chmod 600 "$path"
  printf 'Wrote encrypted %s\n' "$path"
}

if [[ "$do_gdrive" -eq 1 ]]; then
  client_id=""
  client_secret=""
  prompt client_id "Google OAuth client_id: "
  prompt client_secret "Google OAuth client_secret: "
  write_cred gdrive_client_id "$client_id"
  write_cred gdrive_client_secret "$client_secret"
fi

if [[ "$do_nas" -eq 1 ]]; then
  nas_pass=""
  prompt nas_pass "NAS SMB password: "
  write_cred nas_pass "$nas_pass"
fi

if [[ "$do_crypt" -eq 1 ]]; then
  crypt_password=""
  crypt_password2=""
  prompt crypt_password "Crypt password: "
  prompt crypt_password2 "Crypt password2 (salt): "
  write_cred nas_crypt_password "$crypt_password"
  write_cred nas_crypt_password2 "$crypt_password2"
fi

printf 'Reload and test:\n'
printf '  systemctl --user daemon-reload\n'
printf '  systemctl --user start gdrive-backup.service\n'
printf '  systemctl --user status gdrive-backup.service\n'
