[Unit]
Description=Backup Google Drive to encrypted NAS
After=network-online.target
Wants=network-online.target
ConditionPathExists=%h/.config/gdrive-backup/config
ConditionPathExists=%h/.config/credstore.encrypted/gdrive_client_id
ConditionPathExists=%h/.config/credstore.encrypted/gdrive_client_secret
ConditionPathExists=%h/.config/credstore.encrypted/nas_pass
ConditionPathExists=%h/.config/credstore.encrypted/nas_crypt_password
ConditionPathExists=%h/.config/credstore.encrypted/nas_crypt_password2

[Service]
Type=oneshot
# mise shims first so rclone from mise is visible without a login shell.
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# User-encrypted credentials (systemd-creds encrypt --user). Populate with:
#   bin/gdrive-backup-store-creds
LoadCredentialEncrypted=gdrive_client_id:%h/.config/credstore.encrypted/gdrive_client_id
LoadCredentialEncrypted=gdrive_client_secret:%h/.config/credstore.encrypted/gdrive_client_secret
LoadCredentialEncrypted=nas_pass:%h/.config/credstore.encrypted/nas_pass
LoadCredentialEncrypted=nas_crypt_password:%h/.config/credstore.encrypted/nas_crypt_password
LoadCredentialEncrypted=nas_crypt_password2:%h/.config/credstore.encrypted/nas_crypt_password2
ExecStart=%h/.local/bin/gdrive-backup.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# Large first sync / ebook libraries can take a while.
TimeoutStartSec=6h
