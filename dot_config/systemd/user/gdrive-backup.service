[Unit]
Description=Backup Google Drive to encrypted NAS
After=network-online.target
Wants=network-online.target
ConditionPathExists=%h/.config/gdrive-backup/config
ConditionPathExists=%h/.config/credstore/gdrive_client_id
ConditionPathExists=%h/.config/credstore/gdrive_client_secret

[Service]
Type=oneshot
# mise shims first so rclone from mise is visible without a login shell.
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Plaintext files under ~/.config/credstore (mode 600). Absolute paths are
# required for reliable LoadCredential= in the user manager on systemd 255.
# LoadCredentialEncrypted= is not used yet: user-scoped decrypt is unreliable
# on this systemd version (exit 243/CREDENTIALS).
LoadCredential=gdrive_client_id:%h/.config/credstore/gdrive_client_id
LoadCredential=gdrive_client_secret:%h/.config/credstore/gdrive_client_secret
ExecStart=%h/.local/bin/gdrive-backup.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# Large first sync / ebook libraries can take a while.
TimeoutStartSec=6h
