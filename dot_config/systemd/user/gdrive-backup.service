[Unit]
Description=Backup Google Drive to encrypted NAS
After=network-online.target
Wants=network-online.target
ConditionPathExists=%h/.config/gdrive-backup/config

[Service]
Type=oneshot
# mise shims first so rclone from mise is visible without a login shell.
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/gdrive-backup.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# Large first sync / ebook libraries can take a while.
TimeoutStartSec=6h
